<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{3E8F1A57-6C2D-4B9E-A1F4-8D07C5B2E960}</ProjectGuid>
        <MainSource>DelphiLspMcp.dpr</MainSource>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <ProjectName Condition="'$(ProjectName)'==''">DelphiLspMcp</ProjectName>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Console</AppType>
        <FrameworkType>None</FrameworkType>
        <ProjectVersion>20.4</ProjectVersion>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_E>false</DCC_E>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_ImageBase>00400000</DCC_ImageBase>
        <SanitizedProjectName>DelphiLspMcp</SanitizedProjectName>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_DcuOutput>.\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=;FileDescription=DelphiLSP MCP Service (stdio host);FileVersion=0.2.0.0;InternalName=;LegalCopyright=;LegalTrademarks=;OriginalFilename=;ProductName=DelphiLSP MCP Service;ProductVersion=0.2.0.0;Comments=</VerInfo_Keys>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;$(DCC_Namespace)</DCC_Namespace>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Protocol\MCPServer.Types.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Protocol\MCPServer.Serializer.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Protocol\MCPServer.Schema.Generator.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Protocol\MCPServer.JsonRpcProcessor.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Core\MCPServer.Logger.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Core\MCPServer.Settings.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Core\MCPServer.Registration.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Core\MCPServer.ManagerRegistry.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Tools\MCPServer.Tool.Base.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Resources\MCPServer.Resource.Base.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Server\MCPServer.StdioTransport.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Managers\MCPServer.CoreManager.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Managers\MCPServer.ToolsManager.pas"/>
        <DCCReference Include="..\vendor\gdk-mcp-server\src\Managers\MCPServer.ResourcesManager.pas"/>
        <DCCReference Include="Lsp.Transport.Process.pas"/>
        <DCCReference Include="Lsp.Client.pas"/>
        <DCCReference Include="Lsp.Discovery.pas"/>
        <DCCReference Include="Lsp.ConfigFabricator.pas"/>
        <DCCReference Include="Lsp.Session.pas"/>
        <DCCReference Include="Lsp.References.pas"/>
        <DCCReference Include="Lsp.BuildRunner.pas"/>
        <DCCReference Include="Lsp.Patch.pas"/>
        <DCCReference Include="Mcp.Tools.DelphiLsp.pas"/>
        <DCCReference Include="Mcp.Tools.DelphiExtra.pas"/>
        <DCCReference Include="Mcp.Tools.DelphiPatch.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">DelphiLspMcp.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">True</Platform>
            </Platforms>
        </BorlandProject>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
