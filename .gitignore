# --- node/ binaries: build output of BuildGroup.bat Release, packaged by
# tests/release_check.py (which refuses a missing or stale one). Never
# versioned - the two ELFs were, until 2026-09-24, and grew the history
# by 3 MB per rebuild while the two .exe were never in.
node/McpDesktopNode
node/McpRunJob
# the two .res msbuild rewrites on every build (only its PLATFORMTARGETS
# marker, 4 bytes: the platform linked last) and recreates when missing;
# tracked until 2026-10-14, they showed as modified after every build
src/DesktopNode/McpDesktopNode.res
src/RunJob/McpRunJob.res

# --- LSP / machine-local configs (contain absolute local paths) ---
*.delphilsp.json
*.lsif

# --- Logs and temp ---
*.log
*.trace
tmp/


# --- Runtime data next to the executable (never versioned) ---
reports/
settings.ini
__delphi-patch/
__delphi-temp/

__pycache__/
*.pyc
release-out/
# cerrojo de las tareas programadas de Claude Code: entro por accidente en la v0.60
.claude/scheduled_tasks.lock
