<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <Import Condition="Exists('$(BDS)\bin\CodeGear.Deployment.targets')" Project="$(BDS)\bin\CodeGear.Deployment.targets"/>
    <ProjectExtensions>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <ItemGroup Condition="'$(Platform)'=='Linux64' And '$(Config)'=='Debug'">
        <DeployFile Include="Linux64\Debug\McpDesktopNode">
            <RemoteDir>McpDesktopNode\</RemoteDir>
            <RemoteName>McpDesktopNode</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='Linux64' And '$(Config)'=='Release'">
        <DeployFile Include="Linux64\Release\McpDesktopNode">
            <RemoteDir>McpDesktopNode\</RemoteDir>
            <RemoteName>McpDesktopNode</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
    </ItemGroup>
    <ItemGroup Condition="'$(Platform)'=='Win64'">
        <DeployFile Include="Win64\Debug\McpDesktopNode.exe" Condition="'$(Config)'=='Debug'">
            <RemoteDir>McpDesktopNode\</RemoteDir>
            <RemoteName>McpDesktopNode.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
        <DeployFile Include="Win64\Release\McpDesktopNode.exe" Condition="'$(Config)'=='Release'">
            <RemoteDir>McpDesktopNode\</RemoteDir>
            <RemoteName>McpDesktopNode.exe</RemoteName>
            <DeployClass>ProjectOutput</DeployClass>
            <Operation>1</Operation>
            <LocalCommand/>
            <RemoteCommand/>
            <Overwrite>True</Overwrite>
            <Required>True</Required>
        </DeployFile>
    </ItemGroup>
</Project>
